// Measures the linear depth at the center of the screen for AutoFocusComponent. Averages a small
// grid of depth samples around the center and writes the result (or -1 if every sample hit the
// far plane) into a one-element buffer that is read back on the CPU.

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch switch2

#pragma kernel KMain

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"

#define GRID_SIZE 5

TEXTURE2D_X(_AutoFocusDepth);
RWStructuredBuffer<float> _AutoFocusResult;

// x: size of the sampled area as a fraction of the screen height
float4 _AutoFocusParams;

[numthreads(1, 1, 1)]
void KMain(uint3 dispatchThreadId : SV_DispatchThreadID)
{
	UNITY_XR_ASSIGN_VIEW_INDEX(dispatchThreadId.z);

	const float2 center = _ScreenSize.xy * 0.5;
	const float spacing = _AutoFocusParams.x * _ScreenSize.y / (GRID_SIZE - 1);

	float sum = 0;
	float count = 0;
	for (int y = 0; y < GRID_SIZE; y++) {
		for (int x = 0; x < GRID_SIZE; x++) {
			const float2 offset = (float2(x, y) - (GRID_SIZE - 1) * 0.5) * spacing;
			const uint2 coord = (uint2)clamp(center + offset, 0, _ScreenSize.xy - 1);
			const float deviceDepth = LOAD_TEXTURE2D_X(_AutoFocusDepth, coord).r;
			if (deviceDepth != UNITY_RAW_FAR_CLIP_VALUE) {
				sum += LinearEyeDepth(deviceDepth, _ZBufferParams);
				count += 1;
			}
		}
	}
	_AutoFocusResult[0] = count > 0 ? sum / count : -1;
}
